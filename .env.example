# --- Google Ads ---
# Optional: Google now ignores developer tokens (access level comes from your Cloud project)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Your manager (MCC) account ID, digits only, no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Client account where campaigns are created, digits only, no dashes
GOOGLE_ADS_CUSTOMER_ID=

# --- Meta Ads ---
# Long-lived user access token OR system user token with ads_management permission.
META_ACCESS_TOKEN=
# Ad account ID including the "act_" prefix, e.g. act_1234567890
META_AD_ACCOUNT_ID=
# Facebook Page ID the ads will represent
META_PAGE_ID=
